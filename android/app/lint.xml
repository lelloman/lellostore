<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
      Wireless Debugging uses adbd's self-signed certificate and authenticates the client with
      its paired ADB key. Lint flags libadb-android's corresponding trust manager; keep this
      exclusion limited to that third-party artifact.
    -->
    <issue id="TrustAllX509TrustManager">
        <ignore regexp=".*libadb-android.*" />
    </issue>
</lint>
