<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LelloStore" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/lello_background</item>
        <item name="android:navigationBarColor">@color/lello_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/lello_green</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_monochrome</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/lello_green</item>
    </style>
</resources>
